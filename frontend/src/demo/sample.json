   "levers": {
    "demand_change_pct": -15,
    "supplier_cost_change_pct": 8,
    "lead_time_change_days": 1,
    "unexpected_expense": 4000,
    "unexpected_expense_day": 45
   },
   "assumptions": [
    "All adverse conditions happen together for the whole period.",
    "The business does not react by cutting costs."
   ],
   "color_index": 4
  },
  {
   "id": "lean",
   "kind": "inventory",
   "name": "Lean Ordering World",
