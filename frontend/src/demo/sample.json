    "price_change_pct": 4,
    "price_products": [
     "pantry",
     "beverages",
     "household"
    ]
   },
   "assumptions": [
    "Price elasticity values in the model hold for a 4% change.",
    "Competitors do not change their prices."
   ],
   "color_index": 3
  },
  {
   "id": "stress",
   "kind": "stress",
   "name": "Economic Stress World",
   "description": "Demand falls 15%, supplier prices rise 8%, deliveries arrive a day later and a $4,000 repair bill lands mid-period.",
