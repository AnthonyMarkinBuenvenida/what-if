# Copy to backend/.env (optional). Every setting has a working default.
# Names starting with STARTUP_ are kept from before the What-if rename so existing setups keep working.
# These values stay on the server; none of them is ever sent to the browser.

# ---- Live data (Prometheus) -------------------------------------------------
# URL of a Prometheus server (standard HTTP API). Leave unset to run without live data.
# PROMETHEUS_URL=http://127.0.0.1:9090
# Optional authentication (use one):
# PROMETHEUS_BEARER_TOKEN=...
# PROMETHEUS_USERNAME=...
# PROMETHEUS_PASSWORD=...
# PROMETHEUS_TIMEOUT_SECONDS=5
# PROMETHEUS_VERIFY_TLS=1
# PROMETHEUS_STALE_AFTER_SECONDS=300        # samples older than this are flagged "stale"
# PROMETHEUS_DISPLAY_NAME=Prometheus
# STARTUP_PROMETHEUS_JOB=startup            # scrape job name used for StartUp's own /metrics
# STARTUP_METRICS_ENABLED=1                  # expose /metrics (StartUp's operational telemetry)
#
# Business metrics are NEVER inferred. Map them explicitly (JSON list, or a path to a .json file):
# STARTUP_BUSINESS_METRICS='[{"key":"units_sold_daily","label":"Units sold per day","query":"sum(increase(shop_units_sold_total[1d]))","unit":"units/day","use":"demand","freshness_selector":"shop_units_sold_total"}]'
#   use: "display" (shown only), "demand" or "revenue" (can be compared with a model and, if you approve, calibrate it)
# Who may see mapped business metrics: local (default, only this machine) | all | off
# STARTUP_LIVE_BUSINESS_ACCESS=local

# ---- AI (question reading and explanations) ----------------------------------
# Without a provider, What-if still calculates everything: questions are read by a
# rule-based parser and explanations are written from the calculation, both labelled.
# The AI never produces or changes a number.
# WHATIF_AI_PROVIDER=anthropic            # anthropic (default) | openai_compatible | none
# ANTHROPIC_API_KEY=sk-ant-...
# WHATIF_AI_MODEL=claude-opus-5-5         # (STARTUP_AI_MODEL is still read as a fallback)
# WHATIF_AI_TIMEOUT_SECONDS=60
# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama, vLLM) instead:
# WHATIF_AI_PROVIDER=openai_compatible
# WHATIF_AI_BASE_URL=https://api.example.com/v1
# WHATIF_AI_MODEL=model-name
# WHATIF_AI_API_KEY=...
# WHATIF_AI_MAX_TOKENS=4000               # output cap per AI call (OpenRouter reserves credit for it)
# OpenRouter example: WHATIF_AI_BASE_URL=https://openrouter.ai/api/v1  WHATIF_AI_MODEL=anthropic/claude-opus-5.5
# STARTUP_AI_DISABLED=0                   # 1 turns AI off whatever is configured

# ---- External data -----------------------------------------------------------
# Frankfurter (exchange rates), World Bank (inflation, lending rate, GDP growth) and
# Open-Meteo (weather) need no keys.
# Open-Meteo's FREE API IS FOR NON-COMMERCIAL USE ONLY (under 10,000 calls/day, CC-BY 4.0).
# For a commercial deployment use a paid Open-Meteo plan or turn weather off:
# WHATIF_WEATHER_PROVIDER=open_meteo      # open_meteo (default) | none
# WHATIF_OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com/v1   # paid plans
# WHATIF_OPEN_METEO_API_KEY=...           # paid plans only; sent as `apikey`
# STARTUP_CONTACT=you@example.com         # optional contact added to the User-Agent
#
# Optional apilayer sources (free plans: 100 requests/month, HTTPS, NON-COMMERCIAL USE ONLY).
# Keys are sent as `access_key` and removed from every URL What-if stores or shows.
# Weatherstack (weatherstack.com): adds reported current conditions to the weather card.
#   Its free plan has no forecast, so the 16-day forecast stays with Open-Meteo.
# WHATIF_WEATHERSTACK_API_KEY=...
# Marketstack (marketstack.com): end-of-day prices for the ticker set in Business setup
#   (External exposure → Stock to follow). Free plan: end of day only, 1 year of history.
# WHATIF_MARKETSTACK_API_KEY=...

# ---- Storage and workspaces -------------------------------------------------
# Default: SQLite file in backend/data/. For PostgreSQL install a driver, e.g. `pip install "psycopg[binary]"`:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/startup
# Signs the anonymous workspace cookie (a random key is generated in backend/data/.secret_key if unset):
# STARTUP_SECRET_KEY=change-me
# STARTUP_COOKIE_SECURE=1            # set when serving over HTTPS
# STARTUP_SIM_WORKERS=4              # parallel simulation workers
# STARTUP_CORS_ORIGINS=http://localhost:5173
